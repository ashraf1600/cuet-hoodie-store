# REQUIRED for the live site — where orders go.
# Google Apps Script web app URL. Setup: README.md → "Connect the Google Sheet" (script: google-apps-script/Code.gs)
VITE_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# Alternative (not recommended): Google Form. Only used if the webhook above is empty,
# and ALL of the entry IDs below must be filled in.
VITE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/your-form-id/viewform

# (Optional for Option 2) Google Form Entry IDs:
# VITE_GF_ENTRY_ORDER_NUMBER=entry.1000001
# VITE_GF_ENTRY_NAME=entry.1000002
# VITE_GF_ENTRY_STUDENT_ID=entry.1000003
# VITE_GF_ENTRY_EMAIL=entry.1000004
# VITE_GF_ENTRY_PHONE=entry.1000005
# VITE_GF_ENTRY_BATCH=entry.1000006
# VITE_GF_ENTRY_HOODIE=entry.1000007
# VITE_GF_ENTRY_COLOUR=entry.1000008
# VITE_GF_ENTRY_SIZE=entry.1000009
# VITE_GF_ENTRY_QTY=entry.1000010
# VITE_GF_ENTRY_TOTAL=entry.1000011
# VITE_GF_ENTRY_BKASH=entry.1000012
# VITE_GF_ENTRY_TRXID=entry.1000013
# VITE_GF_ENTRY_ADDRESS=entry.1000014
# VITE_GF_ENTRY_NOTES=entry.1000015

# bKash Merchant / Personal payment receiver number
VITE_BKASH_MERCHANT_NUMBER=017XXXXXXXX

